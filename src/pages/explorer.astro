---
import BaseLayout from "../layouts/BaseLayout.astro";

const base = import.meta.env.BASE_URL;

const resources = [
  { title: "OpenStreetMap Wiki", type: "Documentation", domain: "Géomatique & données", language: "Multilingue", description: "Documentation collaborative pour comprendre et contribuer au projet cartographique OpenStreetMap.", url: "https://wiki.openstreetmap.org/" },
  { title: "Documentation QGIS", type: "Documentation", domain: "Géomatique & données", language: "Multilingue", description: "Guides officiels pour apprendre à utiliser QGIS, du niveau débutant aux fonctions avancées.", url: "https://docs.qgis.org/" },
  { title: "NASA Earthdata", type: "Données", domain: "Sciences & recherche", language: "Anglais", description: "Portail d'accès aux données d'observation de la Terre et aux ressources scientifiques de la NASA.", url: "https://earthdata.nasa.gov/" },
  { title: "Wikidata", type: "Outil", domain: "Culture & langues", language: "Multilingue", description: "Base de connaissances libre et structurée, éditée de manière collaborative.", url: "https://www.wikidata.org/" },
  { title: "Khan Academy", type: "Cours", domain: "Éducation & pédagogie", language: "Multilingue", description: "Cours et exercices gratuits dans de nombreuses disciplines.", url: "https://www.khanacademy.org/" },
  { title: "Google Earth Engine", type: "Outil", domain: "Environnement", language: "Anglais", description: "Plateforme de calcul géospatial pour l'analyse de données satellitaires et environnementales.", url: "https://earthengine.google.com/" },
];
const domains = ["Toutes les disciplines", ...new Set(resources.map((r) => r.domain))];
---
<BaseLayout title="Explorer les ressources — KEU DIRU" description="Explorez des ressources sélectionnées dans le catalogue de démonstration KEU DIRU.">
  <header class="topbar">
    <div class="container nav">
      <a class="brand" href={base}><span class="brand-mark">K</span><span>KEU <strong>DIRU</strong><small>La connaissance en partage</small></span></a>
      <nav><a href={base}>Accueil</a><a class="active" href={`${base}explorer/`}>Explorer</a><a href="/#parcours">Parcours</a></nav>
      <a class="back-home" href={base}>Retour à l'accueil ↗</a>
    </div>
  </header>
  <main class="container explorer">
    <p class="eyebrow">Le catalogue KEU DIRU</p>
    <h1>Explorer les ressources.</h1>
    <p class="intro">Découvrez une sélection de ressources de référence. Ce catalogue est une démonstration initiale : les données sont statiques et seront remplacées par le catalogue communautaire après mise en place du backend.</p>
    <div class="toolbar">
      <label class="search"><span aria-hidden="true">⌕</span><span class="sr-only">Rechercher</span><input id="resource-search" type="search" placeholder="Rechercher par titre, description..." /></label>
      <label class="filter-label">Discipline
        <select id="domain-filter">
          {domains.map((domain) => <option value={domain}>{domain}</option>)}
        </select>
      </label>
      <label class="filter-label">Type
        <select id="type-filter">
          <option value="Tous les types">Tous les types</option>
          {["Documentation", "Données", "Outil", "Cours"].map((type) => <option value={type}>{type}</option>)}
        </select>
      </label>
    </div>
    <div class="result-line"><span id="result-count">{resources.length} ressources</span><span class="demo-label">DONNÉES DE DÉMONSTRATION</span></div>
    <div class="resource-grid" id="resource-grid">
      {resources.map((resource, index) => (
        <article class="resource-card" data-title={resource.title.toLowerCase()} data-description={resource.description.toLowerCase()} data-domain={resource.domain} data-type={resource.type}>
          <div class="card-top"><span class="card-index">R{String(index + 1).padStart(2, "0")}</span><span class="resource-type">{resource.type}</span></div>
          <p class="resource-domain">{resource.domain}</p>
          <h2>{resource.title}</h2>
          <p class="resource-description">{resource.description}</p>
          <div class="card-bottom"><span>{resource.language}</span><a href={resource.url} target="_blank" rel="noopener noreferrer">Consulter la ressource ↗</a></div>
        </article>
      ))}
    </div>
    <p id="empty-state" class="empty-state" hidden>Aucune ressource ne correspond à votre recherche. Essayez d'autres mots-clés ou filtres.</p>
  </main>
  <footer class="footer"><div class="container footer-inner"><a class="brand" href={base}><span class="brand-mark">K</span><span>KEU <strong>DIRU</strong><small>La connaissance en partage</small></span></a><span>© {new Date().getFullYear()} KEU DIRU</span></div></footer>
</BaseLayout>

<script>
  const search = document.querySelector<HTMLInputElement>("#resource-search");
  const domain = document.querySelector<HTMLSelectElement>("#domain-filter");
  const type = document.querySelector<HTMLSelectElement>("#type-filter");
  const cards = Array.from(document.querySelectorAll<HTMLElement>(".resource-card"));
  const count = document.querySelector<HTMLElement>("#result-count");
  const empty = document.querySelector<HTMLElement>("#empty-state");

  function filterResources() {
    const query = (search?.value ?? "").trim().toLocaleLowerCase();
    const selectedDomain = domain?.value ?? "Toutes les disciplines";
    const selectedType = type?.value ?? "Tous les types";
    let visible = 0;

    for (const card of cards) {
      const matchesQuery = `${card.dataset.title} ${card.dataset.description}`.includes(query);
      const matchesDomain = selectedDomain === "Toutes les disciplines" || card.dataset.domain === selectedDomain;
      const matchesType = selectedType === "Tous les types" || card.dataset.type === selectedType;
      const show = matchesQuery && matchesDomain && matchesType;
      card.hidden = !show;
      if (show) visible += 1;
    }

    if (count) count.textContent = `${visible} ressource${visible > 1 ? "s" : ""}`;
    if (empty) empty.hidden = visible !== 0;
  }

  search?.addEventListener("input", filterResources);
  domain?.addEventListener("change", filterResources);
  type?.addEventListener("change", filterResources);

  const initialQuery = new URLSearchParams(window.location.search).get("q");
  if (search && initialQuery) search.value = initialQuery;
  filterResources();
</script>

<style>
  .topbar { background:#173d2b; color:#fff; }.nav { min-height:78px; display:flex; align-items:center; justify-content:space-between; gap:24px; }
  .brand { display:flex; align-items:center; gap:11px; font-size:1rem; letter-spacing:.08em; }.brand strong { font-weight:900; }.brand small { display:block; font-size:.58rem; letter-spacing:.04em; color:#b8c9bd; margin-top:3px; }
  .brand-mark { display:grid; place-items:center; width:39px; height:39px; border:1px solid #d6a64b; color:#f0c36e; border-radius:12px 12px 12px 3px; font-weight:900; }
  nav { display:flex; gap:28px; font-size:.88rem; color:#d5e1d8; }nav a:hover,nav .active { color:#f0c36e; }
  .back-home { border:1px solid #789482; border-radius:999px; padding:10px 15px; font-size:.82rem; }
  .explorer { padding-block:74px 110px; }.eyebrow { color:#47745b; font-size:.75rem; font-weight:800; letter-spacing:.13em; text-transform:uppercase; }
  h1 { margin:13px 0; color:#193c2a; font-size:clamp(2.7rem,6vw,4.7rem); letter-spacing:-.06em; line-height:1; }
  .intro { max-width:720px; color:#69796e; line-height:1.8; }
  .toolbar { display:flex; gap:12px; align-items:end; margin-top:34px; padding:16px; background:#fff; border:1px solid #e1e7df; border-radius:13px; }
  .search { display:flex; align-items:center; gap:10px; flex:1; min-width:220px; border:1px solid #dce4dc; border-radius:9px; padding:0 13px; height:46px; color:#65816d; }
  .search span:first-child { font-size:1.4rem; }.search input { width:100%; border:0; outline:0; background:transparent; color:#203b2b; }
  .filter-label { display:grid; gap:6px; color:#647369; font-size:.72rem; font-weight:700; }.filter-label select { min-width:175px; height:46px; padding:0 12px; border:1px solid #dce4dc; border-radius:9px; background:#fff; color:#294333; }
  .result-line { display:flex; justify-content:space-between; align-items:center; margin:27px 0 14px; color:#647369; font-size:.82rem; }
  .demo-label { color:#9a7434; font-size:.62rem; letter-spacing:.12em; font-weight:800; }
  .resource-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:15px; }
  .resource-card { display:flex; flex-direction:column; min-height:260px; padding:22px; background:#fff; border:1px solid #e1e7df; border-radius:12px; }
  .card-top { display:flex; justify-content:space-between; align-items:center; }.card-index { color:#9aa69c; font-size:.7rem; letter-spacing:.12em; }.resource-type { padding:5px 9px; border-radius:99px; background:#edf2eb; color:#47664f; font-size:.68rem; }
  .resource-domain { margin:24px 0 7px; color:#9a7434; font-size:.7rem; font-weight:750; letter-spacing:.04em; }.resource-card h2 { margin:0; color:#21422e; font-size:1.2rem; letter-spacing:-.02em; }.resource-description { color:#6d7b71; font-size:.86rem; line-height:1.7; }
  .card-bottom { display:flex; justify-content:space-between; align-items:center; gap:12px; margin-top:auto; padding-top:17px; border-top:1px solid #edf0eb; color:#8a978d; font-size:.7rem; }.card-bottom a { color:#315b3e; font-weight:750; }
  .empty-state { padding:40px; text-align:center; color:#758278; background:#fff; border-radius:12px; }
  .footer { background:#123322; color:#dce7df; }.footer-inner { min-height:105px; display:flex; justify-content:space-between; align-items:center; }.footer-inner > span { color:#9eb2a4; font-size:.78rem; }
  .sr-only { position:absolute; width:1px; height:1px; padding:0; margin:-1px; overflow:hidden; clip:rect(0,0,0,0); white-space:nowrap; border:0; }
  [hidden] { display:none !important; }
  @media(max-width:900px) { .resource-grid { grid-template-columns:repeat(2,1fr); }.toolbar { flex-wrap:wrap; }.search { flex-basis:100%; } }
  @media(max-width:600px) { nav { display:none; }.explorer { padding-block:55px 75px; }.resource-grid { grid-template-columns:1fr; }.filter-label { flex:1; }.filter-label select { min-width:0; width:100%; }.footer-inner { padding-block:20px; } }
</style>
