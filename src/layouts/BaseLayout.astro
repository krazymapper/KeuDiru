---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}
const {
  title = "KEU DIRU — Explorer les savoirs",
  description = "Une bibliothèque communautaire pour découvrir, organiser et partager les ressources de connaissance."
} = Astro.props;
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#173d2b" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
